# Razorpay Subscriptions (Test Mode / Production)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=secret_xxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxx
RAZORPAY_PLAN_ID_PRO=plan_qrslice_999
# Annual option: RAZORPAY_PLAN_ID_ANNUAL=plan_qrslice_9999

# Trial Emails (Resend) + Cron Security
RESEND_API_KEY=re_xxx
EMAIL_FROM=QRslice <hello@qrslice.com>
CRON_SECRET=generate-a-long-random-string

# Dedicated HMAC key for receipt stamps & table token signing.
# NEVER use SUPABASE_SERVICE_ROLE_KEY here — key separation limits blast radius.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_CRYPTO_SECRET=generate-a-32-byte-hex-string

# Rate Limiting Controls
ORDER_RATE_LIMIT=15
ORDER_RATE_WINDOW=60

# Web Push (VAPID) — PWA push notifications
# Public key is safe to expose (NEXT_PUBLIC_). Private key is server-only:
# NEVER commit the real private key — set it directly in the hosting env.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:hello@qrslice.com
